# ===============================
# Python / Virtual Environment
# ===============================
.venv/
venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ===============================
# OS / Editor junk
# ===============================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ===============================
# Logs & temp files
# ===============================
*.log
*.tmp
*.bak
*.swp

# ===============================
# Data folder: keep structure, ignore all contents
# ===============================

# Files directly in data/
data/*.json
data/*.csv
data/*.xlsx
data/Code Produit.xlsx
data/tickets_index.csv
*.pdf
*.html

# Raw tickets (root-level, fully ignored)
tickets/

# Subfolder contents
data/raw/*
data/json/*
data/analysis_json/*
data/analysis_pdf/*
data/output/*
data/pageindex/*
data/faiss_db/*

# BM25 subfolders (ignore contents, keep subdirs)
data/bm25/*
!data/bm25/appli/
!data/bm25/dsn/
!data/bm25/outils/
data/bm25/appli/*
data/bm25/dsn/*
data/bm25/outils/*

# Vector index subfolders (ignore contents, keep subdirs)
data/indexes/*
!data/indexes/appli/
!data/indexes/dsn/
!data/indexes/outils/
data/indexes/appli/*
data/indexes/dsn/*
data/indexes/outils/*

# Keep .gitkeep placeholders so empty folders are tracked
!**/.gitkeep

# ===============================
# Model / embedding artifacts
# ===============================
*.bin
*.pt
*.onnx
*.index

# ===============================
# Secrets & config
# ===============================
.env
.env.*